# Postgres connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/svsdesk

# Secret for signing JWTs — set a long random value in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# HTTP port
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend dev + prod URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
